@theme overseer

@base           #050A15
@surface0       #0D1420
@surface1       #141F30
@surface2       #1D2A40
@surface-raised #0D1420
@structure      #141F30

@text           #D8E0E8
@text-muted     #8A9DB0
@text-subtle    #6A7F98
@text-disabled  #4A6080

@accent         #E69F00
@accent-hover   #F0AE1A
@accent-pressed #D89000
@accent-muted   #F5C44D
@accent-fg      #050A15

@hint-cool      #56B4E9
@hint-warm      #D55E00
@hint-neutral   #009E73

@border         #1D2A40
@border-strong  #E69F00
@divider        #141F30

@success        #009E73
@warning        #F0E442
@error          #D55E00
@info           #56B4E9

QLabel#overseerTag {
    background-color: @surface1;
    border: 2px solid @accent;
    color: @accent;
    padding: 6px 10px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 11pt;
}