@theme normal

@base           #0A0F1F
@surface0       #131D35
@surface1       #1A2A48
@surface2       #24365C
@surface-raised #131D35
@structure      #1A2A48

@text           #E0E8F0
@text-muted     #9EAFC0
@text-subtle    #7A8FA8
@text-disabled  #5A7090

@accent         #E69F00
@accent-hover   #F0AE1A
@accent-pressed #D89000
@accent-muted   #F5C44D
@accent-fg      #0A0F1F

@hint-cool      #56B4E9
@hint-warm      #D55E00
@hint-neutral   #009E73

@border         #24365C
@border-strong  #E69F00
@divider        #1A2A48

@success        #009E73
@warning        #F0E442
@error          #D55E00
@info           #56B4E9