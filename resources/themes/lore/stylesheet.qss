@theme lore

@base           #0D1929
@surface0       #162545
@surface1       #1F3A5F
@surface2       #2A4A75
@surface-raised #162545
@structure      #1F3A5F

@text           #E8F0F8
@text-muted     #A8BED0
@text-subtle    #7A96B4
@text-disabled  #5A7A98

@accent         #E69F00
@accent-hover   #F0AE1A
@accent-pressed #D89000
@accent-muted   #F5C44D
@accent-fg      #0D1929

@hint-cool      #56B4E9
@hint-warm      #D55E00
@hint-neutral   #009E73

@border         #2A4A75
@border-strong  #E69F00
@divider        #1F3A5F

@success        #009E73
@warning        #F0E442
@error          #CC79A7
@info           #0072B2

QWidget {
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 10pt;
    font-weight: 400;
}

QLabel {
    background: transparent;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
}

QMainWindow, QDialog, QWidget {
    background-color: @base;
    color: @text;
}

QFrame {
    background-color: @base;
}

QLabel:disabled {
    color: @text-disabled;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text;
    padding: 4px 6px;
    selection-background-color: @accent;
    selection-color: @accent-fg;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid @accent;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: @text-disabled;
    border: 1px solid @divider;
}

QPushButton {
    background-color: @surface1;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text;
    padding: 6px 12px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: @surface2;
}

QPushButton:pressed {
    background-color: @surface0;
    border: 1px solid @accent;
}

QPushButton:default {
    border: 1px solid @accent;
}

QPushButton:disabled {
    background-color: @surface0;
    color: @text-disabled;
    border: 1px solid @divider;
}

QPushButton:focus {
    border: 1px solid @accent;
}

QPushButton#primaryButton, QPushButton[accent="primary"] {
    background-color: @accent;
    color: @accent-fg;
    border: 1px solid @accent;
    font-weight: 600;
}

QPushButton#primaryButton:hover, QPushButton[accent="primary"]:hover {
    background-color: @accent-hover;
    border: 1px solid @accent-hover;
}

QPushButton#primaryButton:pressed, QPushButton[accent="primary"]:pressed {
    background-color: @accent-pressed;
    border: 1px solid @accent-pressed;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    color: @text;
    padding: 4px 4px;
    margin: 0;
}

QToolButton:hover {
    background-color: @surface1;
}

QToolButton:pressed, QToolButton:checked {
    background-color: @surface2;
}

QToolButton:disabled {
    color: @text-disabled;
}

QMenuBar {
    background-color: @base;
    color: @text;
    border-bottom: 1px solid @divider;
    padding: 0;
    spacing: 0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    margin: 0;
}

QMenuBar::item:selected {
    background-color: @surface1;
}

QMenuBar::item:pressed {
    background-color: @surface2;
}

QMenu {
    background-color: @surface-raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 0;
    padding: 4px 0;
}

QMenu::item {
    padding: 4px 24px 4px 24px;
}

QMenu::item:selected {
    background-color: @surface1;
}

QMenu::item:disabled {
    color: @text-disabled;
}

QMenu::separator {
    background-color: @divider;
    height: 1px;
    margin: 4px 0;
}

QMenu::icon {
    margin-left: 6px;
}

QToolBar {
    background-color: @base;
    border: none;
    border-bottom: 1px solid @divider;
    spacing: 4px;
    padding: 4px 4px;
}

QToolBar::separator {
    background-color: @divider;
    width: 1px;
    margin: 4px 4px;
}

QToolBar::handle {
    image: url(none);
}

QTabWidget::pane {
    border: 1px solid @divider;
    border-radius: 0;
    top: -1px;
}

QTabBar::tab {
    background-color: @base;
    color: @text-muted;
    padding: 6px 16px;
    margin-right: 0;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
}

QTabBar::tab:selected {
    background-color: @base;
    color: @text;
    border-bottom: 2px solid @accent;
}

QTabBar::tab:hover:!selected {
    background-color: @surface0;
    color: @text;
    border-bottom: 2px solid @divider;
}

QTabBar::tab:disabled {
    color: @text-disabled;
}

QTabBar::close-button {
    background-color: transparent;
    margin: 0 2px;
}

QTabBar::close-button:hover {
    background-color: @surface2;
    border-radius: 2px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: @base;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: @border;
    border-radius: 0;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: @accent;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    height: 0px;
    width: 0px;
}

QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::left-arrow, QScrollBar::right-arrow {
    background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

QListView, QTreeView {
    background-color: @base;
    alternate-background-color: @surface0;
    gridline-color: @divider;
    color: @text;
    border: 1px solid @divider;
    border-radius: 0;
    outline: none;
}

QListView::item, QTreeView::item {
    padding: 3px 4px;
    border: none;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: @surface2;
    color: @text;
}

QListView::item:hover:!selected, QTreeView::item:hover:!selected {
    background-color: @surface0;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-siblings:!adjoins-item,
QTreeView::branch:has-siblings:adjoins-item,
QTreeView::branch:!has-siblings:adjoins-item {
    border-image: url(none);
    image: url(none);
}

QTreeView::branch:closed:has-children,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: url(none);
    image: url(:/icons/dark/branch_closed.svg);
}

QTreeView::branch:open:has-children,
QTreeView::branch:open:has-children:has-siblings {
    border-image: url(none);
    image: url(:/icons/dark/branch_open.svg);
}

QTableView {
    background-color: @base;
    alternate-background-color: @surface0;
    gridline-color: @divider;
    color: @text;
    border: 1px solid @divider;
    border-radius: 0;
    outline: none;
}

QTableView::item:selected {
    background-color: @surface2;
    color: @text;
}

QTableView::item:hover:!selected {
    background-color: @surface0;
}

QHeaderView::section {
    background-color: @surface0;
    color: @text-muted;
    padding: 4px 8px;
    border: none;
    border-right: 1px solid @divider;
    border-bottom: 1px solid @divider;
    font-weight: 500;
}

QHeaderView::section:hover {
    color: @text;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text;
    padding: 4px 6px;
    min-height: 20px;
}

QComboBox:editable {
    background-color: @surface0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
    padding-right: 2px;
}

QComboBox::down-arrow {
    image: url(:/icons/dark/chevron_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/dark/chevron_down_disabled.svg);
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid @accent;
}

QComboBox QAbstractItemView {
    background-color: @surface-raised;
    selection-background-color: @surface2;
    color: @text;
    border: 1px solid @border;
    border-radius: 0;
    padding: 2px 0;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 3px 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: @surface0;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @surface2;
    color: @text;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: transparent;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @surface1;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: @surface2;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/dark/chevron_up.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(:/icons/dark/chevron_up_disabled.svg);
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/dark/chevron_down.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(:/icons/dark/chevron_down_disabled.svg);
}

QSlider::groove:horizontal, QSlider::groove:vertical {
    background-color: @border;
    border-radius: 0;
}

QSlider::groove:horizontal {
    height: 3px;
}

QSlider::groove:vertical {
    width: 3px;
}

QSlider::handle:horizontal, QSlider::handle:vertical {
    background-color: @accent;
    border-radius: 0;
}

QSlider::handle:horizontal {
    width: 10px;
    margin: -5px 0;
}

QSlider::handle:vertical {
    height: 10px;
    margin: 0 -5px;
}

QSlider::handle:horizontal:hover, QSlider::handle:vertical:hover {
    background-color: @accent-hover;
}

QSlider::handle:horizontal:pressed, QSlider::handle:vertical:pressed {
    background-color: @accent-pressed;
}

QSlider::sub-page:horizontal {
    background-color: @accent;
    border-radius: 0;
}

QSlider::add-page:horizontal {
    background-color: @border;
    border-radius: 0;
}

QDial {
    background-color: transparent;
}

QDial::handle {
    background-color: @accent;
}

QStatusBar {
    background-color: @base;
    color: @text-muted;
    border-top: 1px solid @divider;
}

QStatusBar::item {
    border: none;
    padding: 0 4px;
}

QSizeGrip {
    background-color: transparent;
}

QGroupBox {
    color: @text-muted;
    border: 1px solid @divider;
    border-radius: 0;
    margin-top: 10px;
    padding-top: 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: @text-muted;
}

QCheckBox, QRadioButton {
    color: @text;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QCheckBox::indicator:checked {
    image: url(:/icons/dark/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover {
    image: url(:/icons/dark/checkbox_checked.svg);
}

QCheckBox::indicator:indeterminate {
    image: url(:/icons/dark/checkbox_indeterminate.svg);
}

QCheckBox::indicator:disabled {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QRadioButton::indicator {
    width: 13px;
    height: 13px;
}

QRadioButton::indicator:unchecked {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QRadioButton::indicator:unchecked:hover {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QRadioButton::indicator:checked {
    image: url(:/icons/dark/checkbox_checked.svg);
}

QRadioButton::indicator:checked:hover {
    image: url(:/icons/dark/checkbox_checked.svg);
}

QRadioButton::indicator:disabled {
    image: url(:/icons/dark/checkbox_unchecked.svg);
}

QProgressBar {
    background-color: @surface0;
    border: 1px solid @divider;
    border-radius: 0;
    text-align: center;
    color: @text-muted;
    height: 14px;
    padding: 0;
}

QProgressBar::chunk {
    background-color: @accent;
    border-radius: 0;
}

QSplitter::handle {
    background-color: @divider;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: @accent;
}

QDockWidget {
    color: @text;
    border: 1px solid @divider;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

QDockWidget::title {
    background-color: @surface0;
    padding: 4px 8px;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: @surface1;
    border-radius: 0;
}

QCalendarWidget QWidget {
    alternate-background-color: @surface0;
    color: @text;
}

QCalendarWidget QAbstractButton {
    background-color: @surface0;
    border: 1px solid @divider;
    border-radius: 0;
    padding: 3px;
}

QCalendarWidget QAbstractButton:hover {
    background-color: @surface1;
}

QCalendarWidget QAbstractButton:pressed {
    background-color: @surface2;
}

QCalendarWidget QToolButton:hover {
    background-color: @surface1;
}

QCalendarWidget QToolButton:pressed {
    background-color: @surface2;
}

QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text;
    padding: 4px 6px;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1px solid @accent;
}

QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    border: none;
    background-color: transparent;
    width: 20px;
}

QFileDialog QAbstractItemView {
    background-color: @base;
    color: @text;
    border: 1px solid @divider;
}

QFileDialog QAbstractItemView::item:selected {
    background-color: @surface2;
}

QColorDialog {
    background-color: @base;
    color: @text;
}

QFontDialog QAbstractItemView {
    background-color: @base;
    color: @text;
    border: 1px solid @divider;
}

QFontDialog QAbstractItemView::item:selected {
    background-color: @surface2;
}

QMessageBox {
    background-color: @base;
    color: @text;
}

QMessageBox QLabel {
    color: @text;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 70px;
}

QWidget#customTitleBar {
    background-color: @base;
    border-bottom: 1px solid @divider;
}

QMenuBar#titleBarMenuBar {
    background-color: transparent;
    border-bottom: none;
}

QToolButton[windowControl="true"] {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
}

QToolButton[windowControl="true"]:hover {
    background-color: @surface1;
}

QToolButton[windowControl="true"]:pressed {
    background-color: @surface2;
}

QToolButton[windowControlDestructive="true"]:hover {
    background-color: @error;
}

QToolButton[windowControlDestructive="true"]:pressed {
    background-color: @accent-pressed;
}

QToolButton#titleBarMode {
    background-color: @surface1;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text;
    padding: 2px 10px;
    font-weight: 500;
}

QToolButton#titleBarMode:hover {
    background-color: @surface2;
}

QToolButton#titleBarMode::menu-indicator {
    image: url(:/icons/dark/chevron_down.svg);
    width: 8px;
    height: 8px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 6px;
}

QToolButton#titleBarLore {
    background-color: transparent;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text-muted;
    padding: 2px 10px;
    font-weight: 500;
}

QToolButton#titleBarLore:hover {
    background-color: @surface1;
    color: @text;
    border-color: @accent;
}

QToolButton#titleBarAvatar {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 2px;
    color: @text-muted;
    padding: 2px 10px;
    font-weight: 500;
}

QToolButton#titleBarAvatar:hover {
    background-color: @surface1;
    color: @text;
}

QWidget#autoHideStripLeft, QWidget#autoHideStripRight,
QWidget#autoHideStripTop, QWidget#autoHideStripBottom {
    background-color: @surface0;
    border: none;
}

QWidget#autoHideStripLeft {
    border-right: 1px solid @divider;
}

QWidget#autoHideStripRight {
    border-left: 1px solid @divider;
}

QWidget#autoHideStripTop {
    border-bottom: 1px solid @divider;
}

QWidget#autoHideStripBottom {
    border-top: 1px solid @divider;
}
QWidget#assistantShell {
    background-color: @base;
}

QWidget#assistantShellHeader {
    background: transparent;
    padding: 0;
}

QLabel#assistantShellTitle {
    color: @text;
    font-weight: 300;
    letter-spacing: 6px;
    background: transparent;
}

QLabel#assistantShellStatus {
    color: @text-subtle;
    font-size: 9pt;
    font-style: italic;
    background: transparent;
    padding-left: 12px;
}

QComboBox#assistantShellPolicy {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 6px;
    color: @text-muted;
    padding: 6px 12px;
    min-height: 26px;
    font-size: 9pt;
}

QComboBox#assistantShellPolicy:hover {
    background-color: @surface1;
    color: @text;
    border: 1px solid @accent;
}

QComboBox#assistantShellPolicy:focus {
    border: 1px solid @accent;
    color: @text;
}

QComboBox#assistantShellPolicy::drop-down {
    border: none;
    width: 24px;
}

QTabWidget#assistantShellTabs::pane {
    background-color: transparent;
    border: none;
    border-top: 1px solid @divider;
    top: -1px;
}

QTabWidget#assistantShellTabs > QTabBar::tab {
    background-color: transparent;
    color: @text-subtle;
    padding: 12px 24px;
    margin-right: 6px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 10.5pt;
    letter-spacing: 1px;
    text-transform: uppercase;
}

QTabWidget#assistantShellTabs > QTabBar::tab:selected {
    color: @accent;
    border-bottom: 2px solid @accent;
}

QTabWidget#assistantShellTabs > QTabBar::tab:hover:!selected {
    color: @text;
    border-bottom: 2px solid @divider;
}

QScrollArea#assistantShellChatScroll {
    background: transparent;
    border: none;
}

QScrollArea#assistantShellChatScroll > QWidget > QWidget {
    background: transparent;
}

QWidget#assistantShellHero {
    background: transparent;
}

QLabel#assistantShellHeroTitle {
    color: @text;
    font-weight: 300;
    background: transparent;
}

QLabel#assistantShellHeroHint {
    color: @text-subtle;
    font-size: 10.5pt;
    background: transparent;
    line-height: 160%;
}

QGraphicsView#assistantShellMindView {
    background-color: @surface0;
    border: 1px solid @divider;
    border-radius: 8px;
}

QWidget#assistantShellComposer {
    background-color: @surface0;
    border: 1px solid @border;
    border-radius: 12px;
    padding: 0;
}

QLineEdit#assistantShellInput {
    background-color: transparent;
    border: none;
    color: @text;
    padding: 10px 14px;
    font-size: 11pt;
    selection-background-color: @accent;
    selection-color: @accent-fg;
}

QLineEdit#assistantShellInput:focus {
    border: none;
}

QPushButton#assistantShellSend {
    background-color: @accent;
    color: @accent-fg;
    border: none;
    border-radius: 8px;
    padding: 10px 26px;
    font-weight: 600;
    font-size: 10.5pt;
    letter-spacing: 0.5px;
}

QPushButton#assistantShellSend:hover {
    background-color: @accent-hover;
}

QPushButton#assistantShellSend:pressed {
    background-color: @accent-pressed;
}

QPushButton#assistantShellSend:disabled {
    background-color: @surface1;
    color: @text-disabled;
}

QPushButton#assistantShellAbort {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 8px;
    color: @text-muted;
    padding: 0;
    font-weight: 700;
}

QPushButton#assistantShellAbort:hover {
    background-color: @error;
    color: @accent-fg;
    border: 1px solid @error;
}

QToolButton#assistantShellDictate,
QToolButton#assistantShellLive,
QToolButton#assistantShellReadAloud {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 8px;
    color: @text-muted;
    padding: 0;
    font-size: 13pt;
    font-weight: 600;
}

QToolButton#assistantShellDictate:hover,
QToolButton#assistantShellLive:hover,
QToolButton#assistantShellReadAloud:hover {
    background-color: @surface1;
    color: @text;
    border: 1px solid @accent;
}

QToolButton#assistantShellDictate[active="true"],
QToolButton#assistantShellLive[active="true"],
QToolButton#assistantShellReadAloud[active="true"] {
    background-color: @error;
    color: @accent-fg;
    border: 1px solid @error;
}

QToolButton#assistantShellDictate:disabled,
QToolButton#assistantShellLive:disabled,
QToolButton#assistantShellReadAloud:disabled {
    color: @text-disabled;
    border: 1px solid @divider;
}

QListWidget#assistantExplorerList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QListWidget#assistantExplorerList::item {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: @text-muted;
    padding: 6px 10px;
    margin: 1px 4px;
}

QListWidget#assistantExplorerList::item:hover:!selected {
    background-color: @surface0;
    color: @text;
}

QListWidget#assistantExplorerList::item:selected {
    background-color: @surface1;
    color: @text;
}

QLabel#assistantExplorerHeading {
    color: @text-subtle;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 4px 6px 0 6px;
    background: transparent;
}

QToolButton#assistantExplorerNew {
    background-color: transparent;
    border: 1px solid @border;
    border-radius: 4px;
    color: @text-muted;
    font-size: 14pt;
    font-weight: 600;
    padding: 0;
}

QToolButton#assistantExplorerNew:hover {
    background-color: @surface1;
    color: @accent;
    border: 1px solid @accent;
}

QListWidget#assistantExplorerList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QListWidget#assistantExplorerList::item {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: @text-muted;
    padding: 6px 10px;
    margin: 1px 4px;
}

QListWidget#assistantExplorerList::item:hover:!selected {
    background-color: @surface0;
    color: @text;
}

QListWidget#assistantExplorerList::item:selected {
    background-color: @surface1;
    color: @text;
}

QLabel#assistantExplorerHeading {
    color: @text-subtle;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 4px 6px 0 6px;
    background: transparent;
}
QToolButton#assistantShellAttach {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 8px;
    color: @text-muted;
    padding: 0;
    font-size: 15pt;
    font-weight: 600;
}

QToolButton#assistantShellAttach:hover {
    background-color: @surface1;
    color: @accent;
    border: 1px solid @accent;
}

QToolButton#assistantShellAttach:disabled {
    color: @text-disabled;
    border: 1px solid @divider;
}
QWidget#chatNode {
    background: transparent;
}

QWidget#chatNode[role="user"] {
    background-color: @surface1;
    border: 1px solid @border;
    border-radius: 12px;
    padding: 12px 16px;
}

QWidget#chatNode[role="assistant"] {
    background-color: @surface0;
    border: 1px solid @divider;
    border-radius: 12px;
    padding: 12px 16px;
}

QWidget#chatNode[role="job"] {
    background-color: transparent;
    border: none;
    border-left: 2px solid @border;
    border-radius: 0;
    padding: 4px 0 4px 12px;
    margin-left: 4px;
}

QWidget#chatNode[role="status"] {
    background: transparent;
    border: none;
    padding: 0;
}

QWidget#chatNode[role="error"] {
    background-color: @surface0;
    border: 1px solid @error;
    border-radius: 8px;
    padding: 8px 12px;
}

QLabel#chatNodeGlyph {
    color: @accent;
    font-size: 13pt;
    font-weight: 700;
    background: transparent;
}

QLabel#chatNodeTitle {
    color: @text-muted;
    font-size: 10pt;
    font-weight: 500;
    background: transparent;
}

QLabel#chatNodeStatus {
    color: @text-subtle;
    font-size: 9pt;
    font-style: italic;
    background: transparent;
    padding: 2px 0;
}

QLabel#chatNodeError {
    color: @error;
    font-size: 10.5pt;
    font-weight: 600;
    background: transparent;
}

QLabel#chatNodeText {
    color: @text;
    font-size: 11pt;
    background: transparent;
}

QLabel#chatNodeDetail {
    color: @text-subtle;
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 8.5pt;
    background-color: @base;
    border-left: 2px solid @border;
    padding: 6px 12px;
    margin: 2px 0;
}

QLabel#chatNodeErrorBody {
    color: @error;
    font-size: 10pt;
    background-color: @base;
    border-left: 2px solid @error;
    padding: 8px 12px;
    margin: 2px 0;
}

QPushButton#chatNodeAbort {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 4px;
    color: @text-subtle;
    padding: 0;
    font-weight: 700;
    font-size: 9pt;
}

QPushButton#chatNodeAbort:hover {
    background-color: @error;
    color: @accent-fg;
    border: 1px solid @error;
}

QToolButton#chatNodeArrow {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 4px;
    color: @text-subtle;
    font-size: 14pt;
    padding: 0;
}

QToolButton#chatNodeArrow:hover {
    background-color: @surface1;
    color: @accent;
    border: 1px solid @accent;
}

QTextBrowser#chatNodeMarkdown,
QTextBrowser#markdownView {
    background: transparent;
    border: none;
    color: @text;
    selection-background-color: @accent;
    selection-color: @accent-fg;
}

QWidget#chatNodeCarouselHost {
    background: transparent;
    border: none;
}

QStackedWidget#chatNodePages {
    background: transparent;
    border: none;
}

QWidget#chatNodeChrome {
    background: transparent;
    border: none;
    padding: 2px 0;
}

QToolButton#chatNodePrev,
QToolButton#chatNodeNext {
    background-color: transparent;
    border: 1px solid @divider;
    border-radius: 4px;
    color: @text-muted;
    padding: 0;
    font-size: 11pt;
    font-weight: 600;
}

QToolButton#chatNodePrev:hover,
QToolButton#chatNodeNext:hover {
    background-color: @surface1;
    color: @accent;
    border: 1px solid @accent;
}

QToolButton#chatNodePrev:disabled,
QToolButton#chatNodeNext:disabled {
    color: @text-disabled;
    border: 1px solid @divider;
    background-color: transparent;
}

QWidget#chatNodeDots {
    background: transparent;
    border: none;
}

QToolButton#chatNodeDot {
    background-color: @border;
    border: none;
    border-radius: 5px;
    padding: 0;
    margin: 0;
}

QToolButton#chatNodeDot:hover {
    background-color: @text-muted;
}

QToolButton#chatNodeDot[current="true"] {
    background-color: @accent;
}

QLabel#chatNodeCounter {
    color: @text-subtle;
    font-size: 8.5pt;
    background: transparent;
    padding-left: 6px;
}